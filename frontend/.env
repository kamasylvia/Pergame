NUXT_PUBLIC_BASE_URL=http://localhost:3000
# 同源代理模式(2026-11-12 定型):BASE_API/BASE_CDN 留空走相对路径,
# dev 由 Nitro 中间件转发 /api -> localhost:8201、/pergame/ -> NAS S3。
# 代理 target 通过启动 shell env 传入(见 GOAL-STATE 换机指引)。
NUXT_PUBLIC_BASE_API=
NUXT_PUBLIC_BASE_CDN=
NUXT_PUBLIC_CDN_ENDPOINT=/pergame/

NUXT_PUBLIC_CONFIG_DISABLE_LANDING_PAGE=false
NUXT_PUBLIC_CONFIG_DISABLE_SIGNUP_PAGE=false
NUXT_PUBLIC_CONFIG_DISABLE_NATIVE_LOGIN=false
NUXT_PUBLIC_CONFIG_HIDE_NATIVE_LOGIN_FORM=false
#NUXT_PUBLIC_CONFIG_OIDC_PROVIDER_AUTO_REDIRECT=
