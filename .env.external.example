# ==============================================================================
# Pergame 精简版 .env(复用已有 PostgreSQL + S3)
# 配合 docker-compose.external.yml 使用;自包含版见 .env.example
# ==============================================================================

# ---- 镜像版本 ----
PERGAME_TAG=latest

# ---- 访问地址(浏览器必须可达)----
FRONTEND_URL=http://192.168.1.10:8200
API_URL=http://192.168.1.10:8201
CDN_URL=http://192.168.1.10:8010
CDN_ENDPOINT=/pergame/
FRONTEND_EXTERNAL_PORT=8200
BACKEND_EXTERNAL_PORT=8201

# ---- 认证 ----
JWT_SECRET=<长随机串>
COOKIE_DOMAIN=192.168.1.10
ALLOW_UNSECURE=true
CONFIG_DISABLE_SIGNUP=false
CONFIG_DISABLE_LANDING=false
CONFIG_DISABLE_NATIVE_LOGIN=false

# ---- 外部 PostgreSQL(容器网络内地址)----
# DATABASE_HOST = pg 容器在 postgres 网络里的名字,先确认:
#   docker network inspect postgres --format '{{range .Containers}}{{.Name}} {{end}}'
DATABASE_HOST=pg18
DATABASE_PORT=5432
DATABASE_NAME=pergame
DATABASE_USER=postgres
DATABASE_PASSWORD=<pg 密码>

# ---- 外部 S3 ----
# S3_ENDPOINT 走容器网络(内网);CDN_URL 才是浏览器地址
S3_ENDPOINT=http://172.17.0.1:8010
S3_SECURE=false
S3_ACCESSKEY=<对象存储 access key>
S3_SECRETKEY=<对象存储 secret key>
S3_BUCKET=pergame

# ---- 备份与回收站 ----
SNAPSHOT_INTERVAL_HOURS=0
PERGAME_SNAPSHOT_PASSPHRASE=
TRASH_RETENTION_DAYS=30
TRASH_SWEEP_INTERVAL_HOURS=24
DR_BACKUP_SCHEDULE_HOURS=0
