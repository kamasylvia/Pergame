# dr-backup sidecar (spec backup-restore.md §10): long-running container that
# executes dr-backup.sh jobs handed over by the backend through the shared
# dr_jobs volume.
#
# pg_dump cannot read a database newer than its own major version, so this
# base image's tag IS a compatibility constraint: it must be >= the PostgreSQL
# server version being dumped. The tag below pins the exact minor the live
# deployment runs (PostgreSQL 18.2 on the QNAP) — no floating tag, because a
# silently newer pg_dump minor still writes dump formats the operator did not
# verify. Upgrading the database requires bumping the tag here and rebuilding;
# there is no runtime negotiation between pg_dump and a newer server.
FROM postgres:18.2-alpine

# tzdata: busybox date needs it to resolve IANA zone names, so the TZ env
# var can move the sidecar's backup stamps and scheduled runs off UTC.
RUN apk add --no-cache rclone bash coreutils tzdata

COPY dr-backup.sh /opt/dr/dr-backup.sh
COPY dr-sidecar-entrypoint.sh /opt/dr/dr-sidecar-entrypoint.sh
RUN chmod +x /opt/dr/dr-backup.sh /opt/dr/dr-sidecar-entrypoint.sh

# JOBS_DIR / CONF_DIR point at the shared volumes mounted by compose.
ENV JOBS_DIR=/jobs \
    CONF_DIR=/conf \
    SCHEDULE_HOURS=0 \
    SCAN_INTERVAL_SECONDS=2

ENTRYPOINT ["/opt/dr/dr-sidecar-entrypoint.sh"]
