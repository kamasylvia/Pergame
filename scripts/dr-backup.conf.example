# ==============================================================================
# dr-backup configuration — copy to dr-backup.conf (chmod 600) and edit.
# Format: bash-sourceable. Records are pipe-delimited; no field may contain "|".
# The admin UI writes this file through the structured form; this example is
# for hand-rolling (the UI's "Advanced" editor covers the same fields).
#
# Record shapes — trailing knobs added 2026-11-09 and optional (absent =
# inherit/off, readable by older script versions):
#   s3|name|endpoint|bucket|prefix|access|secret|secure|region|provider
#       [|retain_days|keep_last|cron|crypt_pass]
#   webdav|name|url|user|password|prefix[|retain_days|keep_last|cron|crypt_pass]
#
#   retain_days: per-destination prune age (0 = global RETAIN_DAYS)
#   keep_last:   always keep this many newest snapshots (0 = off)
#   cron:        5-field cron for scheduled backups fired by the backend
#                scheduler as `dr-backup.sh -T <name>` (empty = manual only)
#   crypt_pass:  rclone-crypt passphrase; empty = plaintext dumps. NOTE:
#                enabling crypt starts a fresh object namespace — previously
#                uploaded plaintext snapshots stay in place but become
#                invisible through the crypt remote (and vice versa).
# ==============================================================================

# ---- PostgreSQL sources (X) --------------------------------------------------
# pg|name|host|port|username|password|database
SOURCES=(
  "pg|pergame|postgres|5432|backup_user|change-me|pergame"
  # "pg|second-db|db.example.com|5432|backup_user|change-me|other_app"
)

# ---- S3 destinations (Y) -----------------------------------------------------
# Every dump goes to every destination (S3 + WebDAV alike).
#   secure:   true/false   (use TLS)
#   region:   default us-east-1
#   provider: rclone s3 provider, default "Other" (MinIO/RustFS/Garage; "AWS" for AWS)
S3_DESTINATIONS=(
  "s3|primary|https://s3.example.com:9000|pergame-backups|pg|ACCESS_KEY|SECRET|true|us-east-1|Other|14|30|30 3 * * *|"
  # "s3|offsite|https://s3.other.tld|pergame-dr|pg|KEY|SECRET|true|us-east-1|Other|0|0||"
)

# ---- WebDAV destinations (Z) -------------------------------------------------
# webdav|name|url|username|password|prefix
WEBDAV_DESTINATIONS=(
  "webdav|nas|https://nas.example.com/dav/|backup_user|change-me|pergame/pg|14|0||"
)

# ---- Retention ---------------------------------------------------------------
# Global fallback prune age for destinations whose per-record retain_days = 0.
RETAIN_DAYS=14

# Optional: verify uploaded object size matches local dump (default on).
# Skipped automatically for destinations with crypt_pass set (crypt containers
# have a different size than the plaintext dump; rclone crypt verifies
# integrity internally).
VERIFY_UPLOAD=1
