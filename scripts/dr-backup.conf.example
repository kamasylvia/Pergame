# ==============================================================================
# dr-backup configuration — copy to dr-backup.conf (chmod 600) and edit.
# Format: bash-sourceable. Records are pipe-delimited; no field may contain "|".
# Shape: X PostgreSQL sources, Y S3 destinations, Z WebDAV destinations.
# ==============================================================================

# ---- PostgreSQL sources (X) --------------------------------------------------
# pg|name|host|port|username|password|database
SOURCES=(
  "pg|pergame|localhost|5432|backup_user|change-me|pergame"
  # "pg|second-db|db.example.com|5432|backup_user|change-me|other_app"
)

# ---- S3 destinations (Y) -----------------------------------------------------
# Every dump goes to every destination (S3 + WebDAV alike).
# s3|name|endpoint|bucket|prefix|access_key|secret_key|secure|region|provider
#   secure:   true/false   (use TLS)
#   region:   default us-east-1
#   provider: rclone s3 provider, default "Other" (MinIO/RustFS/Garage/...; "AWS" for AWS)
S3_DESTINATIONS=(
  "s3|primary|https://s3.example.com:9000|pergame-backups|pg|ACCESS_KEY|SECRET|true|us-east-1|Other"
  # "s3|offsite|https://s3.other.tld|pergame-dr|pg|KEY|SECRET|true|us-east-1|Other"
)

# ---- WebDAV destinations (Z) -------------------------------------------------
# webdav|name|url|username|password|prefix
WEBDAV_DESTINATIONS=(
  "webdav|nas|https://nas.example.com/dav/|backup_user|change-me|pergame/pg"
)

# ---- Retention ---------------------------------------------------------------
# Days to keep dumps on destinations (pruned with rclone delete --min-age).
RETAIN_DAYS=14

# Optional: verify uploaded object size matches local dump (default on).
VERIFY_UPLOAD=1
